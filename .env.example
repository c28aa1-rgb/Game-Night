# Copy this file to .env and fill in your own values.

# From https://developer.spotify.com/dashboard -> your app -> Settings -> Client ID.
# This is safe to expose in the browser; the PKCE flow never uses a client secret.
SPOTIFY_CLIENT_ID=

# Herd Mentality uses GPT-5 nano only to suggest merges for uncertain answers.
# Set this in Render's environment settings; it is never sent to browsers.
OPENAI_API_KEY=

# Port the server listens on. Render sets this for you in production.
PORT=3000

# Cards a player needs to win.
TARGET_CARDS=10

# How long the reveal stays on screen before the game moves itself on.
REVEAL_MS=5000

# "Alex is up, starting in 3" — breathing room between turns.
INTRO_MS=3000

# Dead time at the start of each song where nobody may steal.
STEAL_LOCK_MS=10000

# How long a stealer gets to pick both answers. Running out counts as wrong.
STEAL_ANSWER_MS=6000

# How long the steal result holds the room before play resumes.
VERDICT_MS=2800

# Extra songs required beyond the player count before a game may start.
# Wrong guesses recycle back into the deck now, so this is about variety,
# not "won't the game just end abruptly" — safe to lower for a small set.
MIN_DECK_BUFFER=8

# Point the server at a different song pool. Used by the test suites so they
# can never touch the resolved one.
# SONGS_FILE=songs.test.json


# --- Mafia ------------------------------------------------------------------
# Every phase clock, in milliseconds. These are the defaults; a room that plays
# faster or slower than the table below only needs these changed.

# The opening cinematic: the disaster, told by three crew who do not survive it,
# then the ship counting the survivors over the roll call. This is a ceiling
# rather than a length — the phase actually ends when the screen stops talking,
# so a TV that fell back to the shorter drawn opening releases it early. The
# host can cut the whole thing short from their phone.
MAFIA_INTRO_MS=30000

# Narrator line before the first night, so everybody can read their role.
MAFIA_ROLE_DEAL_MS=8000

# Once everyone in a window has acted, the clock jumps to this instead of
# running out — long enough for the narrator's line to land, short enough that
# nobody is waiting on a timer with nothing left to do.
MAFIA_SETTLE_MS=3200
# The same, for the Sensor, who has a scan result to read first.
MAFIA_SCAN_READ_MS=5500

# Phases wait for the narrator to finish a sentence before moving on. These are
# the safety valve: how long a phase will wait for a screen that has stopped
# answering, and the pause left after the last word.
MAFIA_NARRATION_HOLD_MS=15000
MAFIA_NARRATION_GAP_MS=900

# Lights out, then each night window in turn.
MAFIA_NIGHT_INTRO_MS=5000
MAFIA_MAFIA_MS=20000
MAFIA_DETECTIVE_MS=15000
MAFIA_DOCTOR_MS=15000

# The morning report, and the vent cutscene if there was one.
MAFIA_MORNING_MS=8000

# Total floor time. The TV can also set this per game, between 30s and 10min.
MAFIA_DISCUSSION_MS=180000

# Each player's turn to defend themselves when the spotlight is switched on,
# and the open floor left over afterwards however long the spotlight ran.
MAFIA_SPOTLIGHT_MS=20000
MAFIA_OPEN_FLOOR_MIN_MS=30000

# Voting, the tally and its cutscene, and a voted-out Security Officer's shot.
MAFIA_VOTE_MS=40000
MAFIA_ELIMINATION_MS=8000
MAFIA_REVENGE_MS=20000

# --- Chameleon --------------------------------------------------------------
# Automatic holds between dealing roles and opening the clue floor, and
# between a round reveal and the next deal. Hosts can always advance manually.
CHAMELEON_DEAL_MS=20000
CHAMELEON_REVEAL_MS=9500
